# Secrets
.env

# Python
__pycache__/
*.pyc
.venv/
venv/

# IDE
.idea/
.vscode/

# Generated digests. See README: your ratings live in these files until
# stage 3 moves them into SQLite -- back them up before then.
digests/*.md
!digests/.gitkeep

# Your filled-in profile stays local
profile.md
README.md

# Cached paper pool for labeling. Big, regenerable, and specific to a window.
eval/pool.json

# SQLite store. Regenerate with `python init_store.py` from pool.json,
# labels.csv and profile.md -- those remain the human-readable masters.
eval/digest.db
